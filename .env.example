# ローカル開発用環境変数テンプレート。
# 初回セットアップ: cp .env.example .env
#
# .env は次の両方で使われます:
# - Docker Compose の変数置換（${HOST_WEB_PORT} など）
# - web コンテナへの環境変数注入（env_file）

# --- Compose / ホスト ---
HOST_WEB_PORT=8000

# --- Django ---
DJANGO_SECRET_KEY=django-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL（db コンテナの初期化・web の DATABASE_URL と整合） ---
POSTGRES_DB=dualspendcalculator
POSTGRES_USER=dualspendcalculator
POSTGRES_PASSWORD=dualspendcalculator

DATABASE_URL=postgresql://dualspendcalculator:dualspendcalculator@db:5432/dualspendcalculator
