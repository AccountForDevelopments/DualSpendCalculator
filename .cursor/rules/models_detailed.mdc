## 【Part 2】Model実装テンプレート

### パターンA: マスタ (MaterialShape)

```python
import uuid
from django.db import models
from django.utils.translation import gettext_lazy as _


class MaterialShape(models.Model):
    # 1. Fields (ID -> Relation -> Data -> System)
    id = models.UUIDField(_('形状ID'), primary_key=True, default=uuid.uuid4, editable=False)

    # Data Fields
    name = models.CharField(
        _('UI表示用形状名'),
        max_length=50,
        help_text=_('画面表示用の名称（例: 角パイプ, 丸棒）')
    )
    display_format = models.CharField(
        _('表示フォーマット'),
        max_length=255,
        help_text=_('例: {width}×{height}×{thickness}')
    )

    # System Fields
    is_active = models.BooleanField(_('有効フラグ'), default=True)
    created_at = models.DateTimeField(_('作成日時'), auto_now_add=True)
    updated_at = models.DateTimeField(_('更新日時'), auto_now=True)

    # 3. Meta
    class Meta:
        db_table = 'material_shapes'
        verbose_name = _('材料形状')
        verbose_name_plural = _('材料形状マスタ')
        ordering = ['name']
        constraints = []

    # 4. __str__
    def __str__(self):
        return self.name
```

### パターンB: 実体 (Material)

> **注意**: 実際のファイルでは、Enum と QuerySet を Model より前に定義すること（Part 0 参照）。
> 以下は Model クラス単体のテンプレートとして記載。

```python
class Material(models.Model):
    # 1. Fields (ID -> Relation -> Data -> System)

    # ID Field
    id = models.UUIDField(_('材料ID'), primary_key=True, default=uuid.uuid4, editable=False)

    # Relation Fields
    shape = models.ForeignKey(
        'MaterialShape',
        verbose_name=_('形状'),
        on_delete=models.PROTECT,
        related_name='materials',
    )

    # Data Fields
    name = models.CharField(_('表示名'), max_length=255, help_text=_('例: SUS304 角パイプ 50×50×2.0'))
    grade = models.CharField(
        _('材質'),
        max_length=50,
        choices=MaterialGrade.choices,
        help_text=_('例: SUS304, SS400, A5052')
    )
    display_dimension = models.CharField(
        _('表示寸法'),
        max_length=255,
        help_text=_('例: 50×50×2.0, φ16')
    )
    dimension_a = models.DecimalField(
        _('寸法A'),
        max_digits=10,
        decimal_places=2,
        blank=True,
        null=True,  # ER図: NULL 許可 (理由: 形状によっては不要な寸法のため)
        help_text=_('形状に応じた第1寸法値（mm）')
    )
    dimension_b = models.DecimalField(
        _('寸法B'),
        max_digits=10,
        decimal_places=2,
        blank=True,
        null=True,  # ER図: NULL 許可 (理由: 形状によっては不要な寸法のため)
        help_text=_('形状に応じた第2寸法値（mm）')
    )
    # ... 必要に応じて dimension_f まで記述 ...

    finish = models.CharField(
        _('仕上'),
        max_length=50,
        blank=True,
        null=True,  # ER図: NULL 許可 (理由: 仕上指定がない材料も存在するため)
        choices=MaterialFinish.choices,  # Enumを適用
        help_text=_('例: 黒皮, 研磨, 酸洗, HL')
    )
    description = models.TextField(
        _('説明・備考'),
        blank=True,
        null=True,  # ER図: NULL 許可 (理由: 任意入力項目のため)
        help_text=_('材料に関する補足情報や特記事項を記載')
    )

    # System Fields
    is_active = models.BooleanField(_('有効フラグ'), default=True)
    created_at = models.DateTimeField(_('作成日時'), auto_now_add=True)
    updated_at = models.DateTimeField(_('更新日時'), auto_now=True)

    # Manager (カスタムQuerySetがある場合)
    objects = MaterialQuerySet.as_manager()

    # 2. clean()
    def clean(self):
        super().clean()
        # 必要に応じてバリデーションロジックを追加

    # 3. Meta
    class Meta:
        db_table = 'materials'
        verbose_name = _('材料')
        verbose_name_plural = _('材料一覧')
        ordering = ['name']
        constraints = []  # 制約がない場合も空リスト [] を明示する。

    # 4. __str__
    def __str__(self):
        return self.name
```
