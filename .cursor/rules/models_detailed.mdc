## 【Part 1】QuerySet実装テンプレート

### 基本パターン

```python
from django.db import models
from django.db.models import Q, Count, Case, When, Value, F, CharField


class MaterialQuerySet(models.QuerySet):
    """材料の検索クエリセット"""

    # ========================================
    # with_<relation>(): リレーションをEager Load
    # ========================================
    def with_shape(self):
        """形状を事前読み込み"""
        return self.select_related('shape')

    # ========================================
    # with_<computed>(): annotateで計算フィールド追加
    # ========================================
    def with_usage_count(self):
        """使用回数をannotate"""
        return self.annotate(usage_count=Count('recipe_materials'))

    # ========================================
    # for_<use_case>(): 用途別の最適化済みクエリ
    # ========================================
    def for_list(self):
        """一覧表示用"""
        return self.with_shape().filter(is_active=True)

    # ========================================
    # その他: 動詞/形容詞で命名
    # - 状態フィルタ: active(), expired() など
    # - フィールドフィルタ: by_grade(), by_date() など
    # - 複合検索: search()
    # ========================================
    def active(self):
        """有効なもののみ"""
        return self.filter(is_active=True)

    def by_grade(self, grade):
        """材質でフィルタ"""
        return self.filter(grade=grade)

    def by_date(self, start_date, end_date):
        """作成日の範囲でフィルタ"""
        return self.filter(created_at__range=(start_date, end_date))

    def search(self, keyword):
        """
        フリーワード検索。
        対象: 表示名、材質、説明
        """
        if not keyword:
            return self
        return self.filter(
            Q(name__icontains=keyword) |
            Q(grade__icontains=keyword) |
            Q(description__icontains=keyword)
        )
```

### 集計パターン（with_<computed>の応用例）

```python
class RfqQuerySet(models.QuerySet):
    """調達見積の検索クエリセット"""

    def with_quote_status(self):
        """
        回答ステータスを集約してannotate。
        - 全サプライヤが quoted → 'quoted'
        - 1社でも quoting → 'quoting'
        """
        return self.annotate(
            total_suppliers=Count('supplier_rfqs'),
            quoted_count=Count(
                'supplier_rfqs',
                filter=Q(supplier_rfqs__status='quoted')
            ),
        ).annotate(
            aggregated_status=Case(
                When(total_suppliers=F('quoted_count'), then=Value('quoted')),
                default=Value('quoting'),
                output_field=CharField(),
            )
        )

    def with_quote_progress(self):
        """回答進捗（n/m社）をannotate"""
        return self.annotate(
            total_suppliers=Count('supplier_rfqs'),
            quoted_count=Count(
                'supplier_rfqs',
                filter=Q(supplier_rfqs__status='quoted')
            ),
        )

    def for_list(self):
        """一覧表示用（N+1対策 + ステータス集約）"""
        return (
            self
            .with_quote_status()
            .with_quote_progress()
            .filter(is_active=True)
            .order_by('-created_at')
        )
```

