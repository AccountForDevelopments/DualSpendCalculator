## 【Part 0】ファイル構成の全体像

```python
# apps/materials/models.py
"""
ファイル内の記述順序:
1. import 文
2. Choices (Enum) クラス
3. QuerySet クラス
4. Model クラス
"""

import uuid
from django.db import models
from django.db.models import Q, Count
from django.utils.translation import gettext_lazy as _


# ========================================
# 1. Choices (Enum) - glossary.mdc に基づき実装
# ----------------------------------------
# 【命名規則】親エンティティ名 + 属性名
#   - MaterialGrade（Material の grade）
#   - MaterialFinish（Material の finish）
#   - BundleIncludes（Bundle の includes）
#   - RfqLineIncludes（RfqLine の includes）
#
# 【理由】異なるエンティティで同名属性（includes, status等）
#        が存在する場合の名前衝突を防止するため。
# ========================================
class MaterialGrade(models.TextChoices):
    """材料の材質コード"""
    SUS304 = 'SUS304', 'SUS304'
    SS400 = 'SS400', 'SS400'
    A5052 = 'A5052', 'A5052'


class MaterialFinish(models.TextChoices):
    """材料の表面仕上"""
    MILL_SCALE = 'mill_scale', _('黒皮')
    POLISHED = 'polished', _('研磨')
    PICKLED = 'pickled', _('酸洗')
    HAIRLINE = 'hairline', _('HL')


# ========================================
# 2. QuerySet クラス
# ========================================
class MaterialQuerySet(models.QuerySet):
    """材料の検索クエリセット"""

    def with_shape(self):
        """形状を事前読み込み"""
        return self.select_related('shape')

    def for_list(self):
        """一覧表示用"""
        return self.with_shape().filter(is_active=True)

    def active(self):
        """有効なもののみ"""
        return self.filter(is_active=True)

    def by_grade(self, grade):
        """材質でフィルタ"""
        return self.filter(grade=grade)


# ========================================
# 3. Model クラス
# ========================================
class MaterialShape(models.Model):
    """材料形状マスタ"""
    # ... 詳細は Part 2 パターンA を参照 ...
    pass


class Material(models.Model):
    """材料"""
    id = models.UUIDField(_('材料ID'), primary_key=True, default=uuid.uuid4, editable=False)
    # ... フィールド定義 ...

    objects = MaterialQuerySet.as_manager()

    class Meta:
        db_table = 'materials'
        verbose_name = _('材料')
        verbose_name_plural = _('材料一覧')
        ordering = ['name']
        constraints = []

    def __str__(self):
        return self.name
```

