def assert_工程の出力名が正しい(step, *, expected_output_name):
    ...

def assert_エラー詳細の工程名が正しい(error, *, expected_step_name):
    ...

# 悪い例: 達成状態が曖昧 / 検証対象が広すぎる
def assert_recipe_is_valid(result):
    ...

def assert_工程の出力名と数量と単位が正しい(step, expected_name, expected_quantity, expected_unit):
    ...
```
